{
    "label" : "logout",
    "action" : "wlogout --protocol layer-shell",
    "text" : "Déconnexion",
    "keybind" : "l"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Veille",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Redémarrer",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Éteindre",
    "keybind" : "p"
}
