* {
    bg-col: #1e1e2e;
    bg-col-light: #313244;
    border-col: #89b4fa;
    selected-col: #89b4fa;
    text-col: #cdd6f4;
    text-col-inactive: #a6adc8;
}

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 600px;
    background-color: @bg-col;
    border: 2px;
    border-color: @border-col;
    border-radius: 16px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col-light;
    border-radius: 12px;
    padding: 8px;
    margin: 12px;
}

prompt {
    background-color: transparent;
    text-color: @selected-col;
    padding: 0 8px;
}

entry {
    background-color: transparent;
    text-color: @text-col;
    placeholder-color: @text-col-inactive;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @text-col;
}

element selected {
    background-color: @selected-col;
    text-color: #1e1e2e;
}

element-icon {
    size: 28px;
}
