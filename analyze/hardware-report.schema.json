{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HardwareReport",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "system",
    "cpu",
    "memory",
    "gpu",
    "storage",
    "display",
    "install",
    "profiles"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "hostname": { "type": "string" },
    "system": {
      "type": "object",
      "required": ["manufacturer", "model", "firmware"],
      "properties": {
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "firmware": { "type": "string", "enum": ["Uefi", "Bios", "Unknown"] },
        "biosVersion": { "type": "string" }
      }
    },
    "cpu": {
      "type": "object",
      "required": ["name", "cores", "threads", "architecture"],
      "properties": {
        "name": { "type": "string" },
        "cores": { "type": "integer", "minimum": 1 },
        "threads": { "type": "integer", "minimum": 1 },
        "architecture": { "type": "string" }
      }
    },
    "memory": {
      "type": "object",
      "required": ["totalBytes", "totalGiB"],
      "properties": {
        "totalBytes": { "type": "integer", "minimum": 1 },
        "totalGiB": { "type": "number", "minimum": 1 }
      }
    },
    "gpu": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "adapterRamMiB": { "type": ["integer", "null"] },
          "driverVersion": { "type": "string" },
          "isDiscrete": { "type": "boolean" }
        }
      }
    },
    "install": {
      "type": "object",
      "required": ["canInstall"],
      "properties": {
        "canInstall": { "type": "boolean" },
        "reason": { "type": "string" },
        "targetDisk": { "type": ["integer", "null"] },
        "suggestedRootGiB": { "type": "number" },
        "useExistingEfi": { "type": "boolean" }
      }
    },
    "profiles": {
      "type": "object",
      "properties": {
        "dev": { "type": "boolean" },
        "gaming": { "type": "boolean" },
        "office": { "type": "boolean" },
        "video": { "type": "boolean" },
        "hyprland": { "type": "boolean" }
      }
    }
  }
}
