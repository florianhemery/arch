{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HardwareReport",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "system",
    "cpu",
    "memory",
    "gpu",
    "storage",
    "display",
    "install",
    "profiles"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "hostname": { "type": "string" },
    "system": {
      "type": "object",
      "required": ["manufacturer", "model", "firmware"],
      "properties": {
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "firmware": { "type": "string", "enum": ["Uefi", "Bios", "Unknown"] },
        "biosVersion": { "type": "string" }
      }
    },
    "cpu": {
      "type": "object",
      "required": ["name", "cores", "threads", "architecture"],
      "properties": {
        "name": { "type": "string" },
        "cores": { "type": "integer", "minimum": 1 },
        "threads": { "type": "integer", "minimum": 1 },
        "architecture": { "type": "string" }
      }
    },
    "memory": {
      "type": "object",
      "required": ["totalBytes", "totalGiB"],
      "properties": {
        "totalBytes": { "type": "integer", "minimum": 1 },
        "totalGiB": { "type": "number", "minimum": 1 }
      }
    },
    "gpu": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "adapterRamMiB": { "type": ["integer", "null"] },
          "driverVersion": { "type": "string" },
          "isDiscrete": { "type": "boolean" }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["disks"],
      "properties": {
        "disks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["diskNumber", "sizeBytes", "sizeGiB", "partitionStyle"],
            "properties": {
              "diskNumber": { "type": "integer", "minimum": 0 },
              "friendlyName": { "type": "string" },
              "sizeBytes": { "type": "integer", "minimum": 1 },
              "sizeGiB": { "type": "number", "minimum": 0 },
              "partitionStyle": { "type": "string" },
              "unallocatedBytes": { "type": "integer", "minimum": 0 },
              "unallocatedGiB": { "type": "number", "minimum": 0 },
              "partitions": { "type": "array" }
            }
          }
        }
      }
    },
    "display": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "deviceName": { "type": "string" },
            "primary": { "type": "boolean" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "logicalWidth": { "type": "integer", "minimum": 1 },
            "logicalHeight": { "type": "integer", "minimum": 1 },
            "refreshHz": { "type": "number", "minimum": 1 },
            "scale": { "type": "number", "minimum": 0.5 }
          }
        },
        "all": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deviceName": { "type": "string" },
              "primary": { "type": "boolean" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "logicalWidth": { "type": "integer", "minimum": 1 },
              "logicalHeight": { "type": "integer", "minimum": 1 },
              "refreshHz": { "type": "number", "minimum": 1 },
              "scale": { "type": "number", "minimum": 0.5 }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "macAddress": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    "pnpDevices": { "type": "array" },
    "keyboard": {
      "type": "object",
      "properties": {
        "layoutTag": { "type": "string" },
        "culture": { "type": "string" }
      }
    },
    "locale": {
      "type": "object",
      "properties": {
        "timezone": { "type": "string" },
        "language": { "type": "string" }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "bitlocker": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "status": { "type": "string" },
            "mustSuspend": { "type": "boolean" },
            "checkedAsAdmin": { "type": "boolean" }
          }
        }
      }
    },
    "install": {
      "type": "object",
      "required": ["canInstall"],
      "properties": {
        "canInstall": { "type": "boolean" },
        "reason": { "type": "string" },
        "targetDisk": { "type": ["integer", "null"] },
        "suggestedRootGiB": { "type": "number" },
        "useExistingEfi": { "type": "boolean" }
      }
    },
    "profiles": {
      "type": "object",
      "properties": {
        "dev": { "type": "boolean" },
        "gaming": { "type": "boolean" },
        "office": { "type": "boolean" },
        "video": { "type": "boolean" },
        "hyprland": { "type": "boolean" }
      }
    }
  }
}
